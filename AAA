-- ฟังก์ชันสร้างปุ่ม
local function createButton(text, color, order)
    local btn = Instance.new("TextButton")
    local btnCorner = Instance.new("UICorner")
    
    btn.Name = "Btn_" .. tostring(order)
    btn.Parent = ButtonContainer
    btn.BackgroundColor3 = color
    btn.Size = UDim2.new(1, 0, 0, 50)
    btn.Font = Enum.Font.SourceSansBold
    btn.Text = text
    btn.TextColor3 = Color3.fromRGB(255, 255, 255)
    btn.TextSize = 20.000
    btn.LayoutOrder = order
    
    btnCorner.CornerRadius = UDim.new(0, 8)
    btnCorner.Parent = btn
    return btn
end

-- สร้างปุ่มตามรายการ
local btn1 = createButton("1. คัดลอกโค้ด", Color3.fromRGB(0, 102, 255), 1)
local btn2 = createButton("2. รันโค้ด 1 ครั้ง", Color3.fromRGB(0, 170, 0), 2)
local btn3 = createButton("3. บันทึกโค้ด", Color3.fromRGB(70, 70, 70), 3)
local btn4 = createButton("4. ประวัติบันทึก", Color3.fromRGB(130, 50, 200), 4)
local btn5 = createButton("5. รันรัวๆ (0.01s): OFF", Color3.fromRGB(180, 0, 0), 5)

-- ระบบการทำงานของปุ่ม
local savedCode = ""
local autoRun = false

btn1.MouseButton1Click:Connect(function()
    if setclipboard then
        setclipboard(CodeBox.Text)
    end
end)

btn2.MouseButton1Click:Connect(function()
    if CodeBox.Text ~= "" then
        pcall(function()
            loadstring(CodeBox.Text)()
        end)
    end
end)

btn3.MouseButton1Click:Connect(function()
    savedCode = CodeBox.Text
end)

btn4.MouseButton1Click:Connect(function()
    if savedCode ~= "" then
        CodeBox.Text = savedCode
    end
end)

btn5.MouseButton1Click:Connect(function()
    autoRun = not autoRun
    if autoRun then
        btn5.Text = "5. รันรัวๆ (0.01s): ON"
        btn5.BackgroundColor3 = Color3.fromRGB(0, 200, 100)
    else
        btn5.Text = "5. รันรัวๆ (0.01s): OFF"
        btn5.BackgroundColor3 = Color3.fromRGB(180, 0, 0)
    end
end)

-- ลูปการทำงานแบบเร่งสปีดเป็น 0.01 วินาที
task.spawn(function()
    while true do
        task.wait(0.01) -- ปรับดีเลย์เป็น 0.01 วินาที
        if autoRun and CodeBox.Text ~= "" then
            pcall(function()
                loadstring(CodeBox.Text)()
            end)
        end
    end
end)

