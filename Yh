local spawnEvent = game:GetService("ReplicatedStorage"):WaitForChild("SpawnLuckyBlock")
local isRunning = false

-- Create simple toggle button UI
local ScreenGui = Instance.new("ScreenGui")
local Button = Instance.new("TextButton")

ScreenGui.Parent = game.CoreGui
ScreenGui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling

Button.Size = UDim2.new(0, 180, 0, 50)
Button.Position = UDim2.new(0.02, 0, 0.5, -25)
Button.BackgroundColor3 = Color3.fromRGB(35, 35, 35)
Button.BorderColor3 = Color3.fromRGB(80, 80, 80)
Button.Text = "Toggle: OFF"
Button.TextColor3 = Color3.new(1,1,1)
Button.Font = Enum.Font.GothamBold
Button.Parent = ScreenGui

-- Toggle function
Button.MouseButton1Click:Connect(function()
    isRunning = not isRunning
    Button.Text = isRunning and "Toggle: ON" or "Toggle: OFF"
    Button.BackgroundColor3 = isRunning and Color3.fromRGB(25, 100, 40) or Color3.fromRGB(35, 35, 35)
end)

-- Loop execution
task.spawn(function()
    while task.wait(0.5) do
        if isRunning then
            spawnEvent:FireServer()
        end
    end
end)
